# PostgreSQL connection string for the local database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sweety

# Used to sign login tokens. Replace with a long random value.
JWT_SECRET=replace-this-with-a-long-random-secret

# API server port
PORT=4000

# Set true when connecting to a PostgreSQL service that requires SSL
PGSSL=false

# Optional Docker Compose PostgreSQL settings (local development defaults)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sweety

# Demo account used by the seed script
SEED_NAME=Demo Patient
SEED_EMAIL=demo@sweety.local
SEED_PASSWORD=SweetDemo123!
